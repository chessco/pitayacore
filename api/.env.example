# Database Connections
DATABASE_URL="mysql://root:password@localhost:3306/pitayacore_db"
VECTOR_DATABASE_URL="postgresql://postgres:password@localhost:5434/pitayacore_vectors?schema=public"

# Docker Compose Database Provisioning (used in docker-compose.prod.yml)
MYSQL_DATABASE=pitayacore_db
MYSQL_ROOT_PASSWORD=change_this_root_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=pitayacore_vectors

# Auth & Security
JWT_SECRET=change_this_jwt_secret_key
INTERNAL_API_KEY=change_this_internal_api_key

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
FAL_KEY=your_fal_ai_key

# App Environment & Ports
PORT=2014
NODE_ENV=development
APP_URL=http://localhost:2014
