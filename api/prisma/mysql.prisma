generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  communicationSessions CommunicationSession[]
  channels              Channel[]
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String?                @unique
  stripeApiKey          String?
  plan                  Plan                   @default(FREE)
  status                Status                 @default(ACTIVE)
  sector                String?                @default("retail")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  brandingConfig        Json?
  enabledModules        Json?
  isDefault             Boolean                @default(false)
  agents                Agent[]
  costLogs              AiCostLog[]
  campaigns             Campaign[]
  capsules              Capsule[]
  conversationsOld      ConversationOld[]
  corrections           HumanCorrection[]
  knowledge             KnowledgeBase[]
  skills                Skill[]
  tenantFeatures        TenantFeature[]
  users                 User[]
  leads                 Lead[]
  products              Product[]
  categories            Category[]
  orders                Order[]
  stockMovements        StockMovement[]
  contacts              Contact[]
  audiences             Audience[]
  workspaceNotes        WorkspaceNote[]
  workspaceDocuments    WorkspaceDocument[]
  workspaceIdeas        WorkspaceIdea[]
  workspaceRelations    WorkspaceRelation[]
  verticals             TenantVertical[]
  characters            Character[]
  assets                Asset[]
  wallet                CreditWallet?
  socialPosts           SocialPost[]
  userRoles             UserRole[]
  userContexts          UserContext[]
  organizations         Organization?          @relation(fields: [organizationId], references: [id])
  parentProfiles        ParentProfile[]
  teacherProfiles       TeacherProfile[]
  childProfiles         ChildProfile[]
  schools               School[]
  classrooms            Classroom[]
  organizationId        String?
  conversations         Conversation[]
  socialBrands          SocialBrand[]
  socialAudiences       SocialAudience[]
  socialCampaigns       SocialCampaign[]
  socialContentPieces   SocialContentPiece[]
  publishingQueue       PublishingQueue[]
  postAnalytics         PostAnalytics[]
  brands                Brand[]
  whiteLabel            WhiteLabel?
  designAuditLogs       DesignAuditLog[]
  syncManifest          ThemeSyncManifest?
  themeCache            ThemeCache[]
  brandMemories         BrandMemory[]
  appearanceManager     AppearanceManager?
  workers               Worker[]
  scripts               Script[]
  jobs                  Job[]
  jobExecutions         JobExecution[]

  @@index([organizationId])
}

model HumanCorrection {
  id        String   @id @default(uuid())
  tenantId  String
  trigger   String   @db.VarChar(255)
  response  String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id                       String            @id @default(uuid())
  tenantId                 String
  email                    String            @unique
  name                     String
  role                     User_role
  status                   Status            @default(ACTIVE)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now())
  password                 String?
  permissions              Json?
  avatarUrl                String?
  phone                    String?
  lastLoginAt              DateTime?
  emailVerified            Boolean           @default(false)
  assignedConversationsOld ConversationOld[] @relation("AssignedTo")
  conversationsOld         ConversationOld[] @relation("ConversationOwner")
  tenant                   Tenant            @relation(fields: [tenantId], references: [id])
  userRoles                UserRole[]
  userContexts             UserContext[]
  sessions                 Session[]
  parentProfile            ParentProfile?
  teacherProfile           TeacherProfile?
  childProfile             ChildProfile?

  @@index([tenantId], map: "User_tenantId_fkey")
}

model ConversationOld {
  id           String       @id @default(uuid())
  tenantId     String
  userId       String?
  externalId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedToId String?
  source       String       @default("WHATSAPP")
  metadata     Json?
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  user         User?        @relation("ConversationOwner", fields: [userId], references: [id])
  leads        Lead[]
  messagesOld  MessageOld[]

  @@index([assignedToId], map: "ConversationOld_assignedToId_fkey")
  @@index([tenantId], map: "ConversationOld_tenantId_fkey")
  @@index([userId], map: "ConversationOld_userId_fkey")
}

model MessageOld {
  id              String          @id @default(uuid())
  conversationId  String
  tenantId        String
  role            String
  content         String          @db.Text
  classification  String?         @db.Text
  confidence      Float?
  isFlagged       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  hitl            HitlAction?
  conversationOld ConversationOld @relation(fields: [conversationId], references: [id])

  @@index([conversationId], map: "MessageOld_conversationId_fkey")
}

model HitlAction {
  id         String     @id @default(uuid())
  messageId  String     @unique
  tenantId   String
  level      String
  status     String
  reviewerId String?
  comments   String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  messageOld MessageOld @relation(fields: [messageId], references: [id])
}

model Skill {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  description String?
  prompt      String?     @db.Text
  version     String      @default("1.0")
  config      Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      SkillStatus @default(PRE_PRODUCTION)
  suiteId     String?
  slug        String?     @unique
  category    String?

  promptVersions      PromptVersion[]
  agents              AgentSkill[]
  actions             SkillAction[]
  providers           SkillProvider[]
  permissions         SkillPermission[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  suite               Suite?               @relation(fields: [suiteId], references: [id])
  agentTemplateSkills AgentTemplateSkill[]

  @@index([tenantId], map: "Skill_tenantId_fkey")
  @@index([suiteId])
}

model KnowledgeBase {
  id        String               @id @default(uuid())
  tenantId  String?
  title     String
  source    String?
  version   String               @default("1.0")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  status    Status               @default(ACTIVE)
  tenant    Tenant?              @relation(fields: [tenantId], references: [id])
  chunks    KnowledgeBaseChunk[]

  @@index([tenantId], map: "KnowledgeBase_tenantId_fkey")
}

model KnowledgeBaseChunk {
  id        String        @id @default(uuid())
  kbId      String
  tenantId  String?
  content   String        @db.Text
  sequence  Int
  createdAt DateTime      @default(now())
  kb        KnowledgeBase @relation(fields: [kbId], references: [id])

  @@index([kbId], map: "KnowledgeBaseChunk_kbId_fkey")
}

model AiCostLog {
  id        String   @id @default(uuid())
  tenantId  String
  model     String
  tokensIn  Int
  tokensOut Int
  costUsd   Float
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "AiCostLog_tenantId_fkey")
}

model PromptVersion {
  id        String   @id @default(uuid())
  skillId   String
  content   String   @db.Text
  version   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@index([skillId], map: "PromptVersion_skillId_fkey")
}

model Agent {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  slug          String              @unique
  description   String?
  prompt        String              @db.Text
  isActive      Boolean             @default(true)
  config        Json?
  avatar        String?
  category      String?
  defaultModel  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  status        String              @default("PRE_PRODUCTION")
  version       String              @default("1.0")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  versions      AgentVersion[]
  capsules      Capsule[]
  skills        AgentSkill[]
  configuration AgentConfiguration?

  @@index([tenantId], map: "Agent_tenantId_fkey")
}

model AgentVersion {
  id        String   @id @default(uuid())
  agentId   String
  prompt    String   @db.Text
  version   String
  status    String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "AgentVersion_agentId_fkey")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())
}

model Capsule {
  id            String     @id @default(uuid())
  tenantId      String?
  agentId       String
  title         String
  slug          String     @unique
  description   String?    @db.Text
  topic         String
  status        String     @default("DRAFT")
  contentBlocks Json
  knowledgeIds  Json?
  promptConfig  Json?
  ctaConfig     Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
  agent         Agent      @relation(fields: [agentId], references: [id])
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  leads         Lead[]
  orders        Order[]

  @@index([agentId], map: "Capsule_agentId_fkey")
  @@index([tenantId], map: "Capsule_tenantId_fkey")
}

model Lead {
  id                 String              @id @default(uuid())
  tenantId           String?
  capsuleId          String
  campaignId         String?
  conversationId     String?
  name               String
  email              String
  phone              String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  capsule            Capsule             @relation(fields: [capsuleId], references: [id])
  conversationOld    ConversationOld?    @relation(fields: [conversationId], references: [id])
  campaign           Campaign?           @relation(fields: [campaignId], references: [id])
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  contactId          String?
  contact            Contact?            @relation(fields: [contactId], references: [id])
  workspaceRelations WorkspaceRelation[]

  @@index([capsuleId], map: "Lead_capsuleId_fkey")
  @@index([conversationId], map: "Lead_conversationId_fkey")
  @@index([campaignId], map: "Lead_campaignId_fkey")
  @@index([tenantId])
  @@index([contactId])
}

model Feature {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String?         @unique
  description    String?         @db.Text
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  tenantFeatures TenantFeature[]
}

model TenantFeature {
  id        String  @id @default(uuid())
  tenantId  String
  featureId String
  enabled   Boolean @default(false)
  feature   Feature @relation(fields: [featureId], references: [id])
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureId])
  @@index([featureId], map: "TenantFeature_featureId_fkey")
}

model Campaign {
  id                 String          @id @default(uuid())
  tenantId           String
  capsuleId          String
  audienceId         String?
  name               String
  audience           String?         @db.Text
  subject            String
  content            String          @db.Text
  channel            CampaignChannel @default(EMAIL)
  whatsappMessage    String?         @db.Text
  whatsappLinksCount Int             @default(0)
  scheduledAt        DateTime?
  sentAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  templateConfig     Json?
  opensCount         Int             @default(0)
  clicksCount        Int             @default(0)
  capsule            Capsule         @relation(fields: [capsuleId], references: [id])
  audienceList       Audience?       @relation(fields: [audienceId], references: [id])
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  leads              Lead[]
  events             CampaignEvent[]

  @@index([capsuleId], map: "Campaign_capsuleId_fkey")
  @@index([tenantId], map: "Campaign_tenantId_fkey")
  @@index([audienceId])
  @@index([channel])
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  email      String?
  type       String   @default("OPEN") // "OPEN" or "CLICK"
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SkillStatus {
  PRE_PRODUCTION
  PRODUCTION
  INACTIVE
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
}

enum User_role {
  OWNER
  EXPERT
  ADVISOR
  DIRECTOR
  ADMIN
  OPERATOR
  PRODUCER
  SYSTEM
}

model Product {
  id           String          @id @default(uuid())
  tenantId     String
  categoryId   String?
  name         String
  description  String?         @db.Text
  price        Float           @default(0)
  cost         Float           @default(0)
  sku          String?
  stock        Int             @default(0)
  minStock     Int             @default(5) // Reorder point
  currency     String          @default("USD") // base currency
  imageUrl     String?         @db.Text
  isActive     Boolean         @default(true)
  customFields Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  category     Category?       @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  movements    StockMovement[]

  @@index([tenantId])
  @@index([categoryId])
}

model StockMovement {
  id        String   @id @default(uuid())
  productId String
  tenantId  String
  type      String // IN, OUT, ADJUSTMENT, SALE
  quantity  Int
  reason    String?
  userId    String? // Who made the movement
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([tenantId])
}

model Category {
  id       String    @id @default(uuid())
  tenantId String
  name     String
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String
  capsuleId    String?
  customerName String
  email        String?
  phone        String?
  total        Float
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  capsule      Capsule?    @relation(fields: [capsuleId], references: [id])
  contactId    String?
  contact      Contact?    @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([capsuleId])
  @@index([contactId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  cost      Float   @default(0)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Contact {
  provider           String?
  externalId         String?
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  email              String?
  phone              String?
  company            String?
  avatarUrl          String?
  displayName        String?
  status             ContactStatus       @default(LEAD)
  type               ContactType         @default(INDIVIDUAL)
  notes              String?             @db.Text
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  activities         Activity[]
  orders             Order[]
  leads              Lead[]
  deals              Deal[]
  tasks              Task[]
  workspaceRelations WorkspaceRelation[]
  conversations      Conversation[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Activity {
  id        String   @id @default(uuid())
  tenantId  String
  contactId String
  type      String // EMAIL, WHATSAPP, CALL, NOTE, ORDER
  subject   String
  content   String?  @db.Text
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([tenantId])
}

model Deal {
  id                String     @id @default(uuid())
  tenantId          String
  contactId         String
  title             String
  value             Float      @default(0)
  stage             DealStage  @default(NEW)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  contact           Contact    @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([tenantId])
}

model Task {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String?
  title       String
  description String?  @db.Text
  dueDate     DateTime
  status      String   @default("PENDING")
  type        String   @default("TASK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     Contact? @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([tenantId])
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  VIP
  LOST
}

enum ContactType {
  INDIVIDUAL
  COMPANY
}

enum DealStage {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATION
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Audience {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     AudienceMember[]
  campaigns   Campaign[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AudienceMember {
  id         String   @id @default(uuid())
  audienceId String
  email      String
  firstName  String?
  lastName   String?
  phone      String?
  metadata   Json? // Stores generic columns from Google Sheets
  status     String   @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, BOUNCED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([audienceId, email])
  @@index([audienceId])
}

model WorkspaceNote {
  id        String    @id @default(uuid())
  tenantId  String
  title     String
  content   String    @db.Text
  summary   String?   @db.Text
  tags      Json?
  score     Int       @default(0)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  relations WorkspaceRelation[] @relation("NoteRelations")
  votes     WorkspaceNoteVote[]

  @@index([tenantId])
}

model WorkspaceNoteVote {
  id        String        @id @default(uuid())
  noteId    String
  userId    String
  value     Int           // 1 = upvote, -1 = downvote
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  note      WorkspaceNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

model WorkspaceDocument {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String?   @db.Text
  filePath    String
  fileType    String
  tags        Json?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  relations WorkspaceRelation[] @relation("DocumentRelations")

  @@index([tenantId])
}

model WorkspaceIdea {
  id          String              @id @default(uuid())
  tenantId    String
  title       String
  description String?             @db.Text
  status      WorkspaceIdeaStatus @default(DRAFT)
  priority    String?
  category    String?
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  relations WorkspaceRelation[] @relation("IdeaRelations")

  @@index([tenantId])
}

enum WorkspaceIdeaStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  IMPLEMENTED
  ARCHIVED
}

model WorkspaceRelation {
  id       String @id @default(uuid())
  tenantId String

  noteId     String?
  documentId String?
  ideaId     String?

  leadId             String?
  companyId          String?
  contactId          String?
  opportunityId      String?
  externalEntityId   String?
  externalEntityType String?
  knowledgeId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  note     WorkspaceNote?     @relation("NoteRelations", fields: [noteId], references: [id])
  document WorkspaceDocument? @relation("DocumentRelations", fields: [documentId], references: [id])
  idea     WorkspaceIdea?     @relation("IdeaRelations", fields: [ideaId], references: [id])

  lead    Lead?    @relation(fields: [leadId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([noteId])
  @@index([documentId])
  @@index([ideaId])
  @@index([leadId])
  @@index([contactId])
}

// ---------------------------------------------------------
// Operations Suite (Digital Workforce Platform)
// ---------------------------------------------------------

model Worker {
  id            String         @id @default(uuid())
  tenantId      String
  name          String
  type          String         // WINDOWS, LINUX, DOCKER, ANDROID
  version       String         @default("1.0.0")
  status        String         @default("OFFLINE") // ONLINE, OFFLINE, BUSY, ERROR
  capabilities  Json?          // Array of capability strings like "Filesystem.Copy"
  tags          Json?
  environment   Json?
  os            String?
  hostname      String?
  ip            String?
  lastHeartbeat DateTime?
  lastSeen      DateTime?
  health        String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  executions    JobExecution[]

  @@index([tenantId])
}

model Script {
  id          String   @id @default(uuid())
  tenantId    String
  version     String   @default("1.0")
  checksum    String?
  language    String   // POWERSHELL, PYTHON, NODEJS, BASH, SQL, CSHARP
  description String?  @db.Text
  permissions Json?
  content     String   @db.Text
  history     Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId])
}

model Job {
  id                  String         @id @default(uuid())
  tenantId            String
  name                String
  description         String?        @db.Text
  category            String?
  version             String         @default("1.0")
  permissions         Json?
  triggers            Json?
  runtimeRequirements Json?
  executionPlan       Json?
  approvalRequired    Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  executions          JobExecution[]

  @@index([tenantId])
}

model JobExecution {
  id              String             @id @default(uuid())
  tenantId        String
  jobId           String
  workerId        String?
  status          String             @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, WAITING_APPROVAL
  startAt         DateTime?
  endAt           DateTime?
  duration        Int?               // in milliseconds
  logs            Json?
  generatedFiles  Json?
  errors          Json?
  retries         Int                @default(0)
  metrics         Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  job             Job                @relation(fields: [jobId], references: [id])
  worker          Worker?            @relation(fields: [workerId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  steps           JobExecutionStep[]

  @@index([tenantId])
  @@index([jobId])
  @@index([workerId])
}

model JobExecutionStep {
  id             String       @id @default(uuid())
  executionId    String
  name           String
  status         String       @default("PENDING")
  startAt        DateTime?
  endAt          DateTime?
  logs           Json?
  error          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  execution      JobExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model AgentSkill {
