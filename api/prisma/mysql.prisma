  objective       String
  status          String
  channels        Json?
  startDate       DateTime?
  endDate         DateTime?
  frequency       String?
  budget          Float?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

