  agentId   String
  skillId   String
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
}

model Suite {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
}

model SkillAction {
  id          String   @id @default(uuid())
  skillId     String
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, action])
  @@index([skillId])
}

model SkillProvider {
  id            String   @id @default(uuid())
  skillId       String
  provider      String
  configuration Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, provider])
  @@index([skillId])
}

model SkillPermission {
  id            String   @id @default(uuid())
  skillId       String
  permissionKey String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, permissionKey])
  @@index([skillId])
}

// FASE 2: VERTICAL REGISTRY
model Vertical {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants       TenantVertical[]
